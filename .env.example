# Copier ce fichier en .env (jamais publié) et renseigner les valeurs.
# Sur Render, ces valeurs se saisissent dans Environment, pas dans un fichier.

# Clé OpenAI (obligatoire pour le guide vocal)...
OPENAI_API_KEY=
# ...ou, en local seulement, lue dans le .env d'un autre projet (chemin relatif à ce dossier)
# OPENAI_ENV_FILE=../../hebrew-app/backend/.env

# Clé Google Maps Platform (obligatoire) : Maps JavaScript, Places (New), Routes,
# Street View Static, Geocoding
GOOGLE_MAPS_API_KEY=

# Codes d'invitation à usage unique, séparés par des virgules (un par personne invitée)
INVITE_CODES=

# Base de données des comptes (SQLite). Sur Render : /var/data/qfo.sqlite (disque persistant).
# En local, par défaut : data/qfo.sqlite
# DB_PATH=

# Facultatif : clé Google distincte donnée à la page (restreinte au site) ; sinon GOOGLE_MAPS_API_KEY
# GOOGLE_MAPS_BROWSER_KEY=
# Jeton public Mapbox (pk.…, restreint aux adresses de l'appli) : globe de l'écran de départ
MAPBOX_TOKEN=

# Facultatif : nombre maximal de conversations vocales par heure, tous comptes (30 par défaut)
# MAX_SESSIONS_PER_HOUR=30
